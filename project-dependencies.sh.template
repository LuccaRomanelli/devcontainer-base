# ------------------------------------------------------------
# Helper function for robust brew install (handles SIGPIPE)
# ------------------------------------------------------------
# Use this for any brew install that uses taps or might fail
# in container environments with broken pipe errors.
brew_install_safe() {
    local package="$1"
    local max_attempts=3
    for attempt in $(seq 1 $max_attempts); do
        if brew install "$package" 2>&1 | cat; then
            return 0
        fi
        if brew list --formula | grep -q "$(basename "$package")" 2>/dev/null; then
            return 0
        fi
        echo "    Attempt $attempt/$max_attempts failed, retrying..."
        sleep 2
    done
    return 1
}

